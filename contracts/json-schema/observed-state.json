{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "endpoints": {
      "default": [],
      "items": {
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "source",
              "destination",
              "bidirectional",
              "flow",
              "gateway",
              "unknown"
            ],
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "metadata": {
            "default": null
          },
          "node_id": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
            "type": [
              "string",
              "null"
            ]
          },
          "transports": {
            "default": [],
            "description": "Transport labels an adapter recognised on this endpoint, such as\n `webrtc` or `ndi`. Guesses read off the underlying system, not offers.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "label",
          "kind"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "hops": {
      "default": [],
      "items": {
        "description": "Node-reported realisation status for one desired hop.",
        "properties": {
          "egresses": {
            "default": [],
            "items": {
              "description": "Observed status for one identified egress branch.",
              "properties": {
                "branch_id": {
                  "type": "string"
                },
                "condition": {
                  "default": "idle",
                  "description": "Observed condition of one socket on a hop, independent of control-plane lifecycle.",
                  "oneOf": [
                    {
                      "const": "idle",
                      "description": "No connection; the socket is a listener patiently waiting. Healthy.",
                      "type": "string"
                    },
                    {
                      "const": "connecting",
                      "description": "No connection; the socket is a caller still retrying. Ambiguous, not degraded.",
                      "type": "string"
                    },
                    {
                      "const": "connected",
                      "description": "Connection up but rate ~0 — fine on our end, nothing coming through yet.",
                      "type": "string"
                    },
                    {
                      "const": "flowing",
                      "description": "Connection up and media flowing.",
                      "type": "string"
                    },
                    {
                      "const": "stalled",
                      "description": "Ingress once carried media but byte progress has frozen while the flow still\n claims to run — detected across polls, not from any instantaneous field.",
                      "type": "string"
                    }
                  ]
                },
                "resolved": {
                  "properties": {
                    "host": {
                      "type": "string"
                    },
                    "port": {
                      "format": "uint16",
                      "maximum": 65535,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "host",
                    "port"
                  ],
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "stats": {
                  "description": "Socket-level SRT stats mirrored from Strom's `srt-stats` payload.",
                  "properties": {
                    "connections": {
                      "default": 0,
                      "format": "uint",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "packets_received_lost": {
                      "default": 0,
                      "format": "int64",
                      "type": "integer"
                    },
                    "packets_received_retransmitted": {
                      "default": 0,
                      "format": "int64",
                      "type": "integer"
                    },
                    "packets_retransmitted": {
                      "default": 0,
                      "format": "int64",
                      "type": "integer"
                    },
                    "packets_sent_lost": {
                      "default": 0,
                      "format": "int64",
                      "type": "integer"
                    },
                    "rate_mbps": {
                      "default": 0.0,
                      "format": "double",
                      "type": "number"
                    }
                  },
                  "type": [
                    "object",
                    "null"
                  ]
                }
              },
              "required": [
                "branch_id"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "ingress": {
            "description": "Observed condition, address, and statistics for one socket.",
            "properties": {
              "condition": {
                "default": "idle",
                "description": "Observed condition of one socket on a hop, independent of control-plane lifecycle.",
                "oneOf": [
                  {
                    "const": "idle",
                    "description": "No connection; the socket is a listener patiently waiting. Healthy.",
                    "type": "string"
                  },
                  {
                    "const": "connecting",
                    "description": "No connection; the socket is a caller still retrying. Ambiguous, not degraded.",
                    "type": "string"
                  },
                  {
                    "const": "connected",
                    "description": "Connection up but rate ~0 — fine on our end, nothing coming through yet.",
                    "type": "string"
                  },
                  {
                    "const": "flowing",
                    "description": "Connection up and media flowing.",
                    "type": "string"
                  },
                  {
                    "const": "stalled",
                    "description": "Ingress once carried media but byte progress has frozen while the flow still\n claims to run — detected across polls, not from any instantaneous field.",
                    "type": "string"
                  }
                ]
              },
              "resolved": {
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "port": {
                    "format": "uint16",
                    "maximum": 65535,
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "host",
                  "port"
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "stats": {
                "description": "Socket-level SRT stats mirrored from Strom's `srt-stats` payload.",
                "properties": {
                  "connections": {
                    "default": 0,
                    "format": "uint",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "packets_received_lost": {
                    "default": 0,
                    "format": "int64",
                    "type": "integer"
                  },
                  "packets_received_retransmitted": {
                    "default": 0,
                    "format": "int64",
                    "type": "integer"
                  },
                  "packets_retransmitted": {
                    "default": 0,
                    "format": "int64",
                    "type": "integer"
                  },
                  "packets_sent_lost": {
                    "default": 0,
                    "format": "int64",
                    "type": "integer"
                  },
                  "rate_mbps": {
                    "default": 0.0,
                    "format": "double",
                    "type": "number"
                  }
                },
                "type": [
                  "object",
                  "null"
                ]
              }
            },
            "type": "object"
          },
          "merge_ingress": {
            "description": "Observed condition, address, and statistics for one socket.",
            "properties": {
              "condition": {
                "default": "idle",
                "description": "Observed condition of one socket on a hop, independent of control-plane lifecycle.",
                "oneOf": [
                  {
                    "const": "idle",
                    "description": "No connection; the socket is a listener patiently waiting. Healthy.",
                    "type": "string"
                  },
                  {
                    "const": "connecting",
                    "description": "No connection; the socket is a caller still retrying. Ambiguous, not degraded.",
                    "type": "string"
                  },
                  {
                    "const": "connected",
                    "description": "Connection up but rate ~0 — fine on our end, nothing coming through yet.",
                    "type": "string"
                  },
                  {
                    "const": "flowing",
                    "description": "Connection up and media flowing.",
                    "type": "string"
                  },
                  {
                    "const": "stalled",
                    "description": "Ingress once carried media but byte progress has frozen while the flow still\n claims to run — detected across polls, not from any instantaneous field.",
                    "type": "string"
                  }
                ]
              },
              "resolved": {
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "port": {
                    "format": "uint16",
                    "maximum": 65535,
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "host",
                  "port"
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "stats": {
                "description": "Socket-level SRT stats mirrored from Strom's `srt-stats` payload.",
                "properties": {
                  "connections": {
                    "default": 0,
                    "format": "uint",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "packets_received_lost": {
                    "default": 0,
                    "format": "int64",
                    "type": "integer"
                  },
                  "packets_received_retransmitted": {
                    "default": 0,
                    "format": "int64",
                    "type": "integer"
                  },
                  "packets_retransmitted": {
                    "default": 0,
                    "format": "int64",
                    "type": "integer"
                  },
                  "packets_sent_lost": {
                    "default": 0,
                    "format": "int64",
                    "type": "integer"
                  },
                  "rate_mbps": {
                    "default": 0.0,
                    "format": "double",
                    "type": "number"
                  }
                },
                "type": [
                  "object",
                  "null"
                ]
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "node_id": {
            "type": "string"
          },
          "state": {
            "description": "Control-plane lifecycle of a hop's provisioning. Runtime link health is\n reported separately per socket via [`LinkCondition`].",
            "enum": [
              "pending",
              "provisioned",
              "failed"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "node_id",
          "state",
          "ingress"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "nodes": {
      "default": [],
      "items": {
        "properties": {
          "capabilities": {
            "additionalProperties": false,
            "default": {
              "adapters": [],
              "hop_profiles": []
            },
            "properties": {
              "adapters": {
                "default": [],
                "items": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "strom",
                        "nmos",
                        "mxl_domain",
                        "mxl_k8s",
                        "mcm",
                        "vendor",
                        "custom"
                      ],
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "kind"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "hop_profiles": {
                "default": [],
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "egress": {
                      "anyOf": [
                        {
                          "additionalProperties": false,
                          "properties": {
                            "roles": {
                              "items": {
                                "description": "Which end of a link a socket is: `Listen` hosts and `Connect` dials.",
                                "enum": [
                                  "listen",
                                  "connect"
                                ],
                                "type": "string"
                              },
                              "minItems": 1,
                              "type": "array"
                            },
                            "transport": {
                              "description": "A transport that carries media between two nodes.",
                              "oneOf": [
                                {
                                  "enum": [
                                    "srt"
                                  ],
                                  "type": "string"
                                },
                                {
                                  "const": "whip",
                                  "description": "WebRTC ingest. The `Connect` end pushes media to the `Listen` end's\n signalling URL.",
                                  "type": "string"
                                },
                                {
                                  "const": "whep",
                                  "description": "WebRTC playback. The `Connect` end pulls media from the `Listen` end's\n signalling URL.",
                                  "type": "string"
                                }
                              ]
                            }
                          },
                          "required": [
                            "transport",
                            "roles"
                          ],
                          "type": "object"
                        },
                        {
                          "additionalProperties": false,
                          "properties": {
                            "device": {
                              "description": "The node's own capture or display device, where media starts or ends.",
                              "enum": [
                                "capture",
                                "display"
                              ],
                              "type": "string"
                            }
                          },
                          "required": [
                            "device"
                          ],
                          "type": "object"
                        }
                      ]
                    },
                    "id": {
                      "maxLength": 63,
                      "minLength": 1,
                      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
                      "type": "string"
                    },
                    "ingress": {
                      "anyOf": [
                        {
                          "additionalProperties": false,
                          "properties": {
                            "roles": {
                              "items": {
                                "description": "Which end of a link a socket is: `Listen` hosts and `Connect` dials.",
                                "enum": [
                                  "listen",
                                  "connect"
                                ],
                                "type": "string"
                              },
                              "minItems": 1,
                              "type": "array"
                            },
                            "transport": {
                              "description": "A transport that carries media between two nodes.",
                              "oneOf": [
                                {
                                  "enum": [
                                    "srt"
                                  ],
                                  "type": "string"
                                },
                                {
                                  "const": "whip",
                                  "description": "WebRTC ingest. The `Connect` end pushes media to the `Listen` end's\n signalling URL.",
                                  "type": "string"
                                },
                                {
                                  "const": "whep",
                                  "description": "WebRTC playback. The `Connect` end pulls media from the `Listen` end's\n signalling URL.",
                                  "type": "string"
                                }
                              ]
                            }
                          },
                          "required": [
                            "transport",
                            "roles"
                          ],
                          "type": "object"
                        },
                        {
                          "additionalProperties": false,
                          "properties": {
                            "device": {
                              "description": "The node's own capture or display device, where media starts or ends.",
                              "enum": [
                                "capture",
                                "display"
                              ],
                              "type": "string"
                            }
                          },
                          "required": [
                            "device"
                          ],
                          "type": "object"
                        }
                      ]
                    },
                    "max_egresses": {
                      "format": "uint",
                      "minimum": 1,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "merge": {
                      "description": "The hop can take a second ingress of the `ingress` class carrying another\n copy of the same media, and merge the two.",
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "ingress",
                    "egress"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "endpoint": {
            "type": "string"
          },
          "id": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
            "type": "string"
          },
          "status": {
            "enum": [
              "unknown",
              "ready",
              "degraded",
              "offline"
            ],
            "type": "string"
          },
          "topology": {
            "additionalProperties": false,
            "properties": {
              "attachments": {
                "default": [],
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "dial": {
                      "default": false,
                      "type": "boolean"
                    },
                    "id": {
                      "maxLength": 63,
                      "minLength": 1,
                      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
                      "type": "string"
                    },
                    "listeners": {
                      "additionalProperties": false,
                      "default": {},
                      "properties": {
                        "srt": {
                          "additionalProperties": false,
                          "properties": {
                            "host": {
                              "type": "string"
                            },
                            "port_range": {
                              "description": "Inclusive `[start, end]` range of ports a node offers for controller-side\n assignment.",
                              "properties": {
                                "end": {
                                  "format": "uint16",
                                  "maximum": 65535,
                                  "minimum": 0,
                                  "type": "integer"
                                },
                                "start": {
                                  "format": "uint16",
                                  "maximum": 65535,
                                  "minimum": 0,
                                  "type": "integer"
                                }
                              },
                              "required": [
                                "start",
                                "end"
                              ],
                              "type": "object"
                            }
                          },
                          "required": [
                            "host",
                            "port_range"
                          ],
                          "type": [
                            "object",
                            "null"
                          ]
                        },
                        "whep": {
                          "additionalProperties": false,
                          "properties": {
                            "base_url": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "base_url"
                          ],
                          "type": [
                            "object",
                            "null"
                          ]
                        },
                        "whip": {
                          "additionalProperties": false,
                          "properties": {
                            "base_url": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "base_url"
                          ],
                          "type": [
                            "object",
                            "null"
                          ]
                        }
                      },
                      "type": "object"
                    },
                    "network": {
                      "maxLength": 63,
                      "minLength": 1,
                      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "network"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "type": "object"
          }
        },
        "required": [
          "id",
          "endpoint",
          "status",
          "topology"
        ],
        "type": "object"
      },
      "type": "array"
    }
