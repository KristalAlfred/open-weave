{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "changed": {
      "type": "boolean"
    },
    "owner": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
      "type": "string"
    },
    "pruned": {
      "items": {
        "maxLength": 63,
        "minLength": 1,
        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
        "type": "string"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "accepted"
      ],
      "type": "string"
    },
    "streams": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "created",
              "updated",
              "unchanged"
            ],
            "type": "string"
          },
          "generation": {
            "format": "uint64",
            "minimum": 1,
            "type": "integer"
          },
          "name": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
            "type": "string"
          }
        },
        "required": [
          "name",
          "generation",
          "action"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "status",
    "owner",
    "changed",
    "streams",
    "pruned"
  ],
  "title": "StreamSetAccepted",
  "type": "object"
}
