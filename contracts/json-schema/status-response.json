{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "starting"
          ],
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "idle",
            "converging",
            "converged",
            "degraded"
          ],
          "type": "string"
        },
        "streams": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "conditions": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "detail": {
                      "type": "string"
                    },
                    "last_transition_time": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "reason": {
                      "enum": [
                        "placed",
                        "single_path",
                        "disabled",
                        "placement_failed",
                        "nodes_available",
                        "node_missing",
                        "node_offline",
                        "hops_ready",
                        "hops_pending",
                        "hop_failed",
                        "format_compatible",
                        "format_unknown",
                        "format_mismatch",
                        "media_flowing",
                        "awaiting_input",
                        "media_degraded",
                        "media_failed",
                        "media_idle",
                        "not_ready"
                      ],
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        "true",
                        "false",
                        "unknown"
                      ],
                      "type": "string"
                    },
                    "type": {
                      "enum": [
                        "placement_ready",
                        "nodes_available",
                        "hops_ready",
                        "format_compatible",
                        "media_flowing"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "status",
                    "reason",
                    "detail",
                    "last_transition_time"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "destinations": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "conditions": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "detail": {
                            "type": "string"
                          },
                          "last_transition_time": {
                            "format": "date-time",
                            "type": "string"
                          },
                          "reason": {
                            "enum": [
                              "placed",
                              "single_path",
                              "disabled",
                              "placement_failed",
                              "nodes_available",
                              "node_missing",
                              "node_offline",
                              "hops_ready",
                              "hops_pending",
                              "hop_failed",
                              "format_compatible",
                              "format_unknown",
                              "format_mismatch",
                              "media_flowing",
                              "awaiting_input",
                              "media_degraded",
                              "media_failed",
                              "media_idle",
                              "not_ready"
                            ],
                            "type": "string"
                          },
                          "status": {
                            "enum": [
                              "true",
                              "false",
                              "unknown"
                            ],
                            "type": "string"
                          },
                          "type": {
                            "enum": [
                              "placement_ready",
                              "nodes_available",
                              "hops_ready",
                              "format_compatible",
                              "media_flowing"
                            ],
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "status",
                          "reason",
                          "detail",
                          "last_transition_time"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "endpoint": {
                      "additionalProperties": false,
                      "properties": {
                        "host": {
                          "description": "The SRT listener's host. Absent for a WHIP or WHEP endpoint, whose `url`\n carries it.",
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "node": {
                          "type": "string"
                        },
                        "port": {
                          "format": "uint16",
                          "maximum": 65535,
                          "minimum": 0,
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "url": {
                          "description": "What a peer dials: `srt://host:port`, or the WHIP or WHEP URL.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "node",
                        "url"
                      ],
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "id": {
                      "maxLength": 63,
                      "minLength": 1,
                      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
                      "type": "string"
                    },
                    "nodes": {
                      "items": {
                        "maxLength": 63,
                        "minLength": 1,
                        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "status": {
                      "description": "End-to-end status of a path, derived from its hops' conditions.",
                      "oneOf": [
                        {
                          "const": "idle",
                          "description": "The path is disabled.",
                          "type": "string"
                        },
                        {
                          "const": "failed",
                          "description": "At least one hop failed to provision.",
                          "type": "string"
                        },
                        {
                          "const": "pending",
                          "description": "A hop is still provisioning or has not reported yet.",
                          "type": "string"
                        },
                        {
                          "const": "awaiting_input",
                          "description": "Provisioned end to end, but no media is entering at the source.",
                          "type": "string"
                        },
                        {
                          "const": "degraded",
                          "description": "Media is entering at the source but not flowing all the way through.",
                          "type": "string"
                        },
                        {
                          "const": "flowing",
                          "description": "Media is flowing across every hop.",
                          "type": "string"
                        }
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "status",
                    "nodes",
                    "conditions"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "generation": {
                "format": "uint64",
                "minimum": 1,
                "type": "integer"
              },
              "ingress": {
                "additionalProperties": false,
                "properties": {
                  "host": {
                    "description": "The SRT listener's host. Absent for a WHIP or WHEP endpoint, whose `url`\n carries it.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "node": {
                    "type": "string"
                  },
                  "port": {
                    "format": "uint16",
                    "maximum": 65535,
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "url": {
                    "description": "What a peer dials: `srt://host:port`, or the WHIP or WHEP URL.",
                    "type": "string"
                  }
                },
                "required": [
                  "node",
                  "url"
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "name": {
                "maxLength": 63,
                "minLength": 1,
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
                "type": "string"
              },
              "nodes": {
                "items": {
                  "maxLength": 63,
                  "minLength": 1,
                  "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
                  "type": "string"
                },
                "type": "array"
              },
              "observed_generation": {
                "format": "uint64",
                "minimum": 1,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "status": {
                "description": "End-to-end status of a path, derived from its hops' conditions.",
                "oneOf": [
                  {
                    "const": "idle",
                    "description": "The path is disabled.",
                    "type": "string"
                  },
                  {
                    "const": "failed",
                    "description": "At least one hop failed to provision.",
                    "type": "string"
                  },
                  {
                    "const": "pending",
                    "description": "A hop is still provisioning or has not reported yet.",
                    "type": "string"
                  },
                  {
                    "const": "awaiting_input",
                    "description": "Provisioned end to end, but no media is entering at the source.",
                    "type": "string"
                  },
                  {
                    "const": "degraded",
                    "description": "Media is entering at the source but not flowing all the way through.",
                    "type": "string"
                  },
                  {
                    "const": "flowing",
                    "description": "Media is flowing across every hop.",
                    "type": "string"
                  }
                ]
              }
            },
            "required": [
              "name",
              "generation",
              "status",
              "nodes",
              "conditions",
              "destinations"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "summary",
        "streams"
      ],
      "type": "object"
    }
  ],
  "title": "StatusResponse"
}
