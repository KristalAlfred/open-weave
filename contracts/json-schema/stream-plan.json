{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "endpoints": {
      "additionalProperties": false,
      "properties": {
        "destinations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "endpoint": {
                "additionalProperties": false,
                "properties": {
                  "host": {
                    "description": "The SRT listener's host. Absent for a WHIP or WHEP endpoint, whose `url`\n carries it.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "node": {
                    "type": "string"
                  },
                  "port": {
                    "format": "uint16",
                    "maximum": 65535,
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "url": {
                    "description": "What a peer dials: `srt://host:port`, or the WHIP or WHEP URL.",
                    "type": "string"
                  }
                },
                "required": [
                  "node",
                  "url"
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "id": {
                "maxLength": 63,
                "minLength": 1,
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "ingress": {
          "additionalProperties": false,
          "properties": {
            "host": {
              "description": "The SRT listener's host. Absent for a WHIP or WHEP endpoint, whose `url`\n carries it.",
              "type": [
                "string",
                "null"
              ]
            },
            "node": {
              "type": "string"
            },
            "port": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "url": {
              "description": "What a peer dials: `srt://host:port`, or the WHIP or WHEP URL.",
              "type": "string"
            }
          },
          "required": [
            "node",
            "url"
          ],
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "destinations"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "hops": {
      "items": {
        "description": "One provisioning unit placed on a single node: one ingress socket fanned out\n to one or more egress sockets (a sender tees to every destination).",
        "properties": {
          "egresses": {
            "items": {
              "description": "One identified output branch of a desired hop.",
              "properties": {
                "branch_id": {
                  "type": "string"
                },
                "endpoint_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "host": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "params": {
                  "properties": {
                    "latency": {
                      "format": "uint32",
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "passphrase": {
                      "description": "Encrypts the socket. Both ends of a link carry the same passphrase.",
                      "maxLength": 80,
                      "minLength": 10,
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "pbkeylen": {
                      "description": "AES key length in bytes, 16, 24 or 32, used with `passphrase`.",
                      "enum": [
                        16,
                        24,
                        32
                      ],
                      "format": "uint8",
                      "maximum": 255,
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  },
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "port": {
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "role": {
                  "enum": [
                    "listen",
                    "connect",
                    "capture",
                    "display"
                  ],
                  "type": "string"
                },
                "transport": {
                  "enum": [
                    "srt",
                    "whip",
                    "whep",
                    "device"
                  ],
                  "type": "string"
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "branch_id",
                "transport",
                "role"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "ingress": {
            "additionalProperties": false,
            "description": "Flat wire form of a [`SocketSpec`]: a `transport` and `role` naming the\n variant, plus the fields that variant carries.",
            "properties": {
              "endpoint_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "host": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "params": {
                "properties": {
                  "latency": {
                    "format": "uint32",
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "passphrase": {
                    "description": "Encrypts the socket. Both ends of a link carry the same passphrase.",
                    "maxLength": 80,
                    "minLength": 10,
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "pbkeylen": {
                    "description": "AES key length in bytes, 16, 24 or 32, used with `passphrase`.",
                    "enum": [
                      16,
                      24,
                      32
                    ],
                    "format": "uint8",
                    "maximum": 255,
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "type": [
                  "object",
                  "null"
                ]
              },
              "port": {
                "format": "uint16",
                "maximum": 65535,
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "role": {
                "enum": [
                  "listen",
                  "connect",
                  "capture",
                  "display"
                ],
                "type": "string"
              },
              "transport": {
                "enum": [
                  "srt",
                  "whip",
                  "whep",
                  "device"
                ],
                "type": "string"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "transport",
              "role"
            ],
            "type": "object"
          },
          "merge_ingress": {
            "additionalProperties": false,
            "description": "A second ingress carrying another copy of the same media over a disjoint\n path, for the hop to merge with `ingress`. Only a receiver whose profile\n merges has one.",
            "properties": {
              "endpoint_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "host": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "params": {
                "properties": {
                  "latency": {
                    "format": "uint32",
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "passphrase": {
                    "description": "Encrypts the socket. Both ends of a link carry the same passphrase.",
                    "maxLength": 80,
                    "minLength": 10,
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "pbkeylen": {
                    "description": "AES key length in bytes, 16, 24 or 32, used with `passphrase`.",
                    "enum": [
                      16,
                      24,
                      32
                    ],
                    "format": "uint8",
                    "maximum": 255,
                    "minimum": 0,
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "type": [
                  "object",
                  "null"
                ]
              },
              "port": {
                "format": "uint16",
                "maximum": 65535,
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "role": {
                "enum": [
                  "listen",
                  "connect",
                  "capture",
                  "display"
                ],
                "type": "string"
              },
              "transport": {
                "enum": [
                  "srt",
                  "whip",
                  "whep",
                  "device"
                ],
                "type": "string"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "transport",
              "role"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "node_id": {
            "type": "string"
          },
          "profile_id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "sender",
              "bridge",
              "receiver"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "node_id",
          "profile_id",
          "role",
          "ingress",
          "egresses"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "name": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
      "type": "string"
    },
    "nodes": {
      "items": {
        "maxLength": 63,
        "minLength": 1,
        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
        "type": "string"
      },
      "type": "array"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "disabled",
        "placed",
        "unplaced"
      ],
      "type": "string"
    }
  },
  "required": [
    "name",
    "status",
    "nodes",
    "hops"
  ],
  "title": "StreamPlan",
  "type": "object"
}
