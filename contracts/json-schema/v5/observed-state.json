{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "endpoints": {
      "default": [],
      "items": {
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "source",
              "destination",
              "bidirectional",
              "flow",
              "gateway",
              "unknown"
            ],
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "metadata": {
            "default": null
          },
          "node_id": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
            "type": [
              "string",
              "null"
            ]
          },
          "transports": {
            "default": [],
            "description": "Transport labels an adapter recognised on this endpoint, such as\n `webrtc` or `ndi`. Guesses read off the underlying system, not offers.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "label",
          "kind"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "hops": {
      "default": [],
      "items": {
        "description": "Node-reported realisation status for one desired hop.",
        "properties": {
          "egresses": {
            "default": [],
            "items": {
              "description": "Observed status for one identified egress branch.",
              "properties": {
                "branch_id": {
                  "type": "string"
                },
                "condition": {
                  "default": "idle",
                  "description": "Observed condition of one socket on a hop, independent of control-plane lifecycle.",
                  "oneOf": [
                    {
                      "const": "idle",
                      "description": "No connection; the socket is a listener patiently waiting. Healthy.",
                      "type": "string"
                    },
                    {
                      "const": "connecting",
                      "description": "No connection; the socket is a caller still retrying. Ambiguous, not degraded.",
                      "type": "string"
                    },
                    {
                      "const": "connected",
                      "description": "Connection up but rate ~0 — fine on our end, nothing coming through yet.",
                      "type": "string"
                    },
                    {
                      "const": "flowing",
                      "description": "Connection up and media flowing.",
                      "type": "string"
                    },
                    {
                      "const": "stalled",
                      "description": "Ingress once carried media but byte progress has frozen while the flow still\n claims to run — detected across polls, not from any instantaneous field.",
                      "type": "string"
                    }
                  ]
                },
                "resolved": {
                  "properties": {
                    "host": {
                      "type": "string"
                    },
                    "port": {
                      "format": "uint16",
                      "maximum": 65535,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "host",
                    "port"
                  ],
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "stats": {
                  "description": "Socket-level SRT stats mirrored from Strom's `srt-stats` payload.",
                  "properties": {
                    "connections": {
                      "default": 0,
                      "format": "uint",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "packets_received_lost": {
                      "default": 0,
                      "format": "int64",
                      "type": "integer"
                    },
                    "packets_received_retransmitted": {
                      "default": 0,
                      "format": "int64",
                      "type": "integer"
                    },
                    "packets_retransmitted": {
                      "default": 0,
                      "format": "int64",
                      "type": "integer"
                    },
                    "packets_sent_lost": {
                      "default": 0,
                      "format": "int64",
                      "type": "integer"
                    },
                    "rate_mbps": {
                      "default": 0.0,
                      "format": "double",
                      "type": "number"
                    }
                  },
                  "type": [
                    "object",
                    "null"
                  ]
                }
              },
              "required": [
                "branch_id"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "ingress": {
            "description": "Observed condition, address, and statistics for one socket.",
            "properties": {
              "condition": {
                "default": "idle",
                "description": "Observed condition of one socket on a hop, independent of control-plane lifecycle.",
                "oneOf": [
                  {
                    "const": "idle",
                    "description": "No connection; the socket is a listener patiently waiting. Healthy.",
                    "type": "string"
                  },
                  {
                    "const": "connecting",
                    "description": "No connection; the socket is a caller still retrying. Ambiguous, not degraded.",
                    "type": "string"
                  },
                  {
                    "const": "connected",
                    "description": "Connection up but rate ~0 — fine on our end, nothing coming through yet.",
                    "type": "string"
                  },
                  {
                    "const": "flowing",
                    "description": "Connection up and media flowing.",
                    "type": "string"
                  },
                  {
                    "const": "stalled",
                    "description": "Ingress once carried media but byte progress has frozen while the flow still\n claims to run — detected across polls, not from any instantaneous field.",
                    "type": "string"
                  }
                ]
              },
              "resolved": {
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "port": {
                    "format": "uint16",
                    "maximum": 65535,
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "host",
                  "port"
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "stats": {
                "description": "Socket-level SRT stats mirrored from Strom's `srt-stats` payload.",
                "properties": {
                  "connections": {
                    "default": 0,
                    "format": "uint",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "packets_received_lost": {
                    "default": 0,
                    "format": "int64",
                    "type": "integer"
                  },
                  "packets_received_retransmitted": {
                    "default": 0,
                    "format": "int64",
                    "type": "integer"
                  },
                  "packets_retransmitted": {
                    "default": 0,
                    "format": "int64",
                    "type": "integer"
                  },
                  "packets_sent_lost": {
                    "default": 0,
                    "format": "int64",
                    "type": "integer"
                  },
                  "rate_mbps": {
                    "default": 0.0,
                    "format": "double",
                    "type": "number"
                  }
                },
                "type": [
                  "object",
                  "null"
                ]
              }
            },
            "type": "object"
          },
          "node_id": {
            "type": "string"
          },
          "state": {
            "description": "Control-plane lifecycle of a hop's provisioning. Runtime link health is\n reported separately per socket via [`LinkCondition`].",
            "enum": [
              "pending",
              "provisioned",
              "failed"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "node_id",
          "state",
          "ingress"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "nodes": {
      "default": [],
      "items": {
        "properties": {
          "capabilities": {
            "default": {
              "adapters": [],
              "data_plane": {},
              "relay": false,
              "transports": []
            },
            "properties": {
              "adapters": {
                "default": [],
                "items": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "strom",
                        "nmos",
                        "mxl_domain",
                        "mxl_k8s",
                        "mcm",
                        "vendor",
                        "custom"
                      ],
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "kind"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "data_plane": {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "properties": {
                        "host": {
                          "type": "string"
                        },
                        "reachability": {
                          "default": "dialable",
                          "description": "Whether peers can open a connection to an address, or the node behind it can\n only dial out. Planning reads this to decide which end of a link listens.",
                          "oneOf": [
                            {
                              "const": "dialable",
                              "description": "Peers can connect to this address.",
                              "type": "string"
                            },
                            {
                              "const": "outbound_only",
                              "description": "Behind NAT or a firewall: this node must initiate every connection.",
                              "type": "string"
                            }
                          ]
                        },
                        "signalling": {
                          "additionalProperties": false,
                          "default": {},
                          "description": "Base URLs a node serves WHIP and WHEP signalling at, per WebRTC transport.\n A transport with no base is not offered for hosting at that address.",
                          "properties": {
                            "whep": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "whip": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "type": "object"
                        }
                      },
                      "required": [
                        "host"
                      ],
                      "type": "object"
                    }
                  ]
                },
                "default": {},
                "description": "Data-plane addresses this node advertises, keyed by alias. The\n [`DEFAULT_DATA_PLANE_ALIAS`] entry serves node-referenced endpoints\n that pin no network.",
                "type": "object"
              },
              "devices": {
                "description": "Devices the node can capture from or display on.",
                "items": {
                  "description": "The node's own capture or display device, where media starts or ends.",
                  "enum": [
                    "capture",
                    "display"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              "port_range": {
                "description": "Inclusive port range the controller may assign from for this node's\n hops. A soft contract: bind failures surface as [`HopState::Failed`].",
                "properties": {
                  "end": {
                    "format": "uint16",
                    "maximum": 65535,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "start": {
                    "format": "uint16",
                    "maximum": 65535,
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "relay": {
                "default": false,
                "description": "Whether this node may carry transit for streams that neither terminate\n nor originate on it — the pool the planner draws a relay from when two\n endpoints cannot dial each other.",
                "type": "boolean"
              },
              "transports": {
                "default": [],
                "description": "Link transports this node offers, with the roles it can take.",
                "items": {
                  "anyOf": [
                    {
                      "description": "A transport that carries media between two nodes.",
                      "oneOf": [
                        {
                          "enum": [
                            "srt"
                          ],
                          "type": "string"
                        },
                        {
                          "const": "whip",
                          "description": "WebRTC ingest. The `Connect` end pushes media to the `Listen` end's\n signalling URL.",
                          "type": "string"
                        },
                        {
                          "const": "whep",
                          "description": "WebRTC playback. The `Connect` end pulls media from the `Listen` end's\n signalling URL.",
                          "type": "string"
                        }
                      ]
                    },
                    {
                      "properties": {
                        "name": {
                          "description": "A transport that carries media between two nodes.",
                          "oneOf": [
                            {
                              "enum": [
                                "srt"
                              ],
                              "type": "string"
                            },
                            {
                              "const": "whip",
                              "description": "WebRTC ingest. The `Connect` end pushes media to the `Listen` end's\n signalling URL.",
                              "type": "string"
                            },
                            {
                              "const": "whep",
                              "description": "WebRTC playback. The `Connect` end pulls media from the `Listen` end's\n signalling URL.",
                              "type": "string"
                            }
                          ]
                        },
                        "roles": {
                          "default": [
                            "listen",
                            "connect"
                          ],
                          "items": {
                            "description": "Which end of a link a socket is: `Listen` hosts and `Connect` dials.",
                            "enum": [
                              "listen",
                              "connect"
                            ],
                            "type": "string"
                          },
                          "minItems": 1,
                          "type": "array"
                        }
                      },
                      "required": [
                        "name"
                      ],
                      "type": "object"
                    }
                  ]
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "endpoint": {
            "type": "string"
          },
          "id": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
            "type": "string"
          },
          "status": {
            "enum": [
              "unknown",
              "ready",
              "degraded",
              "offline"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "endpoint",
          "status"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "title": "ObservedState",
  "type": "object"
}
