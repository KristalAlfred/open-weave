{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "destinations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "endpoint": {
            "additionalProperties": false,
            "properties": {
              "host": {
                "type": "string"
              },
              "node": {
                "type": "string"
              },
              "port": {
                "format": "uint16",
                "maximum": 65535,
                "minimum": 0,
                "type": "integer"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "node",
              "host",
              "port",
              "url"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "id": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "ingress": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "port": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "node",
        "host",
        "port",
        "url"
      ],
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "destinations"
  ],
  "title": "StreamEndpoints",
  "type": "object"
}
