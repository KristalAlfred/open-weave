compose   := "docker compose -f " + source_directory() / "docker-compose.yml"
scripts   := source_directory() / "scripts"
manifests := source_directory() / "manifests"
nb      := "http://localhost:29080"
sb      := "http://localhost:29081"
ctrl    := "http://localhost:29082"
strom1  := "http://localhost:28080"
strom2  := "http://localhost:28081"
strom3  := "http://localhost:28082"
# Strom that open-live drives (profile `open-live`); not a weave node.
strom_ol := "http://localhost:28083"
page_dir := source_directory() / ".." / "nodes" / "browser"

# Version prefix carrying both control-plane contracts, matching weave_core::API_V1.
# `/health` and the controller dashboard (`/`, `/ui`, `/view`) sit outside it.
v       := "/v1"

# Bearer tokens per API surface. Defaults match docker-compose.yml so the bench
# needs no exports; override by exporting either variable. `/health` and the
# controller dashboard need no token.
nb_token := env("WEAVE_NORTHBOUND_TOKEN", "bench-northbound-token")
sb_token := env("WEAVE_SOUTHBOUND_TOKEN", "bench-southbound-token")
nb_auth  := "-H 'Authorization: Bearer " + nb_token + "'"
sb_auth  := "-H 'Authorization: Bearer " + sb_token + "'"

# Node id the browser page registers under, pinned on the `browser` service's
# `command:` in docker-compose.yml so the browser manifests keep naming it.
browser_node := env("WEAVE_BROWSER_NODE_ID", "browser-bench")

default:
    @just --list

# Build images and bring the whole stack up, then wait for it to be healthy.
up:
    {{compose}} build
    {{compose}} up -d
    @just wait

# Poll every service's health endpoint until the stack is ready.
wait:
    @echo "waiting for stack..."
    @for i in $(seq 1 90); do \
        curl -sf {{nb}}/health   >/dev/null 2>&1 && \
        curl -sf {{sb}}/health   >/dev/null 2>&1 && \
        curl -sf {{ctrl}}/health >/dev/null 2>&1 && \
        curl -sf {{strom1}}/api/version >/dev/null 2>&1 && \
        curl -sf {{strom2}}/api/version >/dev/null 2>&1 && \
        curl -sf {{strom3}}/api/version >/dev/null 2>&1 && \
        { echo "stack ready"; exit 0; }; \
        sleep 2; \
    done; echo "timeout waiting for stack" >&2; {{compose}} ps; exit 1

# Tear everything down: containers, networks, volumes (incl. profiled endpoints).
down:
    {{compose}} --profile producer --profile consumer --profile browser --profile open-live down -v --remove-orphans

ps:
    {{compose}} ps

# Follow logs for a service (e.g. `just logs controller`).
logs svc="controller":
    {{compose}} logs -f --tail=40 {{svc}}

# Health of every service + nodes registered with southbound + controller view.
status:
    @echo "== health =="
    @printf "northbound:  "; curl -sf {{nb}}/health   >/dev/null && echo ok || echo DOWN
    @printf "southbound:  "; curl -sf {{sb}}/health   >/dev/null && echo ok || echo DOWN
    @printf "controller:  "; curl -sf {{ctrl}}/health >/dev/null && echo ok || echo DOWN
    @printf "strom-1:     "; curl -sf {{strom1}}/api/version >/dev/null && echo ok || echo DOWN
    @printf "strom-2:     "; curl -sf {{strom2}}/api/version >/dev/null && echo ok || echo DOWN
    @printf "strom-3:     "; curl -sf {{strom3}}/api/version >/dev/null && echo ok || echo DOWN
    @echo "== registered nodes (southbound) =="
    @curl -sf {{sb_auth}} {{sb}}{{v}}/nodes | (jq . 2>/dev/null || cat)
    @echo "== controller {{v}}/status =="
    @curl -sf {{ctrl}}{{v}}/status | (jq . 2>/dev/null || cat)
    @echo "== streams (northbound) =="
    @curl -sf {{nb_auth}} {{nb}}{{v}}/streams | (jq . 2>/dev/null || cat)

# List the available stream manifests with their one-line description.
stream-ls:
    @for f in {{manifests}}/*.yaml; do \
        printf "%-14s %s\n" "$(basename "$f" .yaml)" "$(head -1 "$f" | sed 's/^# *//')"; \
    done

# Apply a manifest by name (stem == stream name), e.g. `just stream basic`.
# Control plane only: the stream is registered and placed, but nothing feeds it,
# so it settles at `awaiting_input`. Use `just stream-up` to also drive media.
[doc("Apply a manifest by name, control plane only (no media).")]
stream name:
    @WEAVE_NORTHBOUND_URL={{nb}} WEAVE_NORTHBOUND_TOKEN={{nb_token}} \
        cargo run --quiet -p weave-cli -- apply -f {{manifests}}/{{name}}.yaml
    @[ -n "${WEAVE_BENCH_DRIVING:-}" ] || \
        echo "applied {{name}} (no media yet — 'just bench stream-up {{name}}' drives it end to end)"

# Attach the external producer to the stream's ingress and one consumer per
# receiver output, then wait for `flowing`. This is the recipe to reach for;
# `just stream` alone leaves the path unfed.
#
# The producer/consumer containers are singletons, so this re-points them at
# <name>: a previously driven stream loses its media and falls back to `degraded`.
[doc("Apply a manifest AND drive it end to end, waiting for `flowing`.")]
stream-up name="basic":
    #!/usr/bin/env bash
    set -euo pipefail
    WEAVE_BENCH_DRIVING=1 just stream {{name}}
    # Not every manifest is drivable. Wait for placement to resolve, then say why
    # rather than letting endpoint discovery poll a stream that will never place.
    for _ in $(seq 1 10); do
        placed="$(curl -sf {{ctrl}}{{v}}/status \
            | jq -r --arg n {{name}} '.streams[] | select(.name==$n) | .status' 2>/dev/null || true)"
        [ -n "$placed" ] && [ "$placed" != "pending" ] && break
        sleep 2
    done
    case "${placed:-}" in
        idle)
            echo "{{name}} is disabled (enabled: false) — no hops provisioned, nothing to drive"
            exit 0 ;;
        pending|"")
            echo "{{name}} never placed (status ${placed:-unknown}) — no node matched its hops," \
                 "so there is no ingress to feed. 'just bench status' shows registered nodes." >&2
            exit 1 ;;
    esac
    outputs="$(WEAVE_NORTHBOUND_TOKEN={{nb_token}} bash {{scripts}}/endpoints.sh {{name}} outputs)"
    echo "{{name}} placed with $outputs receiver output(s); attaching endpoints"
    just producer-up {{name}}
    just consumer-up {{name}}
    # Only two consumer slots exist; say so rather than silently under-driving a
    # path, which would look like a stuck `degraded`.
    if [ "$outputs" -ge 2 ]; then just consumer-2-up {{name}}; fi
    if [ "$outputs" -gt 2 ]; then
        echo "warning: {{name}} has $outputs outputs but the bench has 2 consumers;" \
             "outputs 2+ stay unattached and the stream will report degraded" >&2
    fi
    just stream-wait {{name}} flowing

# Stop driving a stream and remove it: detach the external endpoints, then delete.
stream-down name="basic":
    -@just producer-down
    -@just consumer-down
    -@just consumer-2-down
    @just stream-rm {{name}}

# Poll the controller until a stream reports `status`, e.g. `just stream-wait basic flowing`.
stream-wait name status="flowing" attempts="45":
    #!/usr/bin/env bash
    set -euo pipefail
    for _ in $(seq 1 {{attempts}}); do
        got="$(curl -sf {{ctrl}}{{v}}/status \
            | jq -r --arg n {{name}} '.streams[] | select(.name==$n) | .status' 2>/dev/null || true)"
        if [ "$got" = "{{status}}" ]; then echo "{{name}}: {{status}}"; exit 0; fi
        sleep 2
    done
    echo "{{name}}: timed out waiting for {{status}} (last: ${got:-unknown})" >&2
    echo "inspect with 'just bench status' or the dashboard at {{ctrl}}/ui" >&2
    exit 1

# Remove a stream by name, e.g. `just stream-rm basic`. Controller tears down its hops next tick.
stream-rm name:
    @curl -sf {{nb_auth}} -X DELETE {{nb}}{{v}}/streams/{{name}} && echo "deleted {{name}}" || echo "not found: {{name}}"

# Pass a stream name; the ingress address is resolved via the controller's
# discovery API. Verification endpoint only — not part of the system under test.
#
# A socket on node 3 can only be dialled from inside net_node3, so the endpoint
# is picked from the address: 172.29.x means the `-3` container, anything else
# the net_core one. The recipe obeys the same reachability the planner does.
[doc("Start the external ffmpeg producer (SRT caller into a source ingress).")]
producer-up stream="basic":
    #!/usr/bin/env bash
    set -euo pipefail
    target="$(WEAVE_NORTHBOUND_TOKEN={{nb_token}} bash {{scripts}}/endpoints.sh {{stream}} ingress)"
    svc="producer$(bash {{scripts}}/inside.sh "$target")"
    echo "producer: dialling $target from $svc"
    PRODUCER_TARGET="$target" {{compose}} --profile producer up -d "$svc"

# Stop and remove the external producer, whichever subnet it was started in.
producer-down:
    -@{{compose}} --profile producer rm -sf producer producer-3

# Pass a stream name; the first output address is resolved via discovery.
[doc("Start the external ffmpeg consumer (SRT caller pulling a receiver output).")]
consumer-up stream="basic":
    #!/usr/bin/env bash
    set -euo pipefail
    source="$(WEAVE_NORTHBOUND_TOKEN={{nb_token}} bash {{scripts}}/endpoints.sh {{stream}} output 0)"
    svc="consumer$(bash {{scripts}}/inside.sh "$source")"
    echo "consumer: dialling $source from $svc"
    CONSUMER_SOURCE="$source" {{compose}} --profile consumer up -d "$svc"

# Stop and remove the external consumer, whichever subnet it was started in.
consumer-down:
    -@{{compose}} --profile consumer rm -sf consumer consumer-3

# For fan-out: one consumer per receiver output, so every receiver hop can flow.
# Pass a stream name; the second output address is resolved via discovery.
[doc("Start a second external consumer, attached to a stream's output 1.")]
consumer-2-up stream="fanout":
    #!/usr/bin/env bash
    set -euo pipefail
    source="$(WEAVE_NORTHBOUND_TOKEN={{nb_token}} bash {{scripts}}/endpoints.sh {{stream}} output 1)"
    CONSUMER_SOURCE_2="$source" {{compose}} --profile consumer up -d consumer-2

# Stop and remove the second external consumer.
consumer-2-down:
    {{compose}} --profile consumer rm -sf consumer-2

# Build and start the headless browser node inside the bench, then print its id.
[doc("Start the in-bench browser node (profile `browser`) and print its node id.")]
browser-up:
    {{compose}} --profile browser up -d --build browser
    @just browser-id

# Wait for the pinned browser node to appear in southbound's registry, then echo it.
browser-id:
    #!/usr/bin/env bash
    set -euo pipefail
    for _ in $(seq 1 30); do
        got="$(curl -sf {{sb_auth}} {{sb}}{{v}}/nodes \
            | jq -r --arg id '{{browser_node}}' '.[] | select(.id==$id) | .id' 2>/dev/null || true)"
        if [ -n "$got" ]; then echo "$got"; exit 0; fi
        sleep 2
    done
    echo "{{browser_node}} has not registered with southbound;" \
         "'just bench logs browser' shows why, 'just bench status' lists the nodes there are" >&2
    exit 1

# Apply browser-cam and browser-return for the page and drive both: the camera
# stream's SRT output is pulled by the consumer, the return stream's SRT ingress
# is fed by the producer and played on the page.
[doc("Apply both browser manifests for <node-id> (default: the pinned page) and drive them end to end.")]
browser-stream id="":
    #!/usr/bin/env bash
    set -euo pipefail
    id="{{id}}"
    [ -n "$id" ] || id="$(just browser-id)"
    tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
    for m in browser-cam browser-return; do
        sed "s/BROWSER_NODE/$id/" {{manifests}}/$m.yaml > "$tmp"
        WEAVE_NORTHBOUND_URL={{nb}} WEAVE_NORTHBOUND_TOKEN={{nb_token}} \
            cargo run --quiet -p weave-cli -- apply -f "$tmp"
    done
    just consumer-up browser-cam
    just producer-up browser-return
    just stream-wait browser-return flowing
    # browser-cam never reaches `flowing` here and is not waited on: the page's
    # Chromium sends no H264, Strom's whip_input accepts nothing else, and its
    # inactivity monitor drops the session every ~20 s, so the stream cycles
    # `degraded` and `pending` (BACKLOG.md).
    printf 'browser-cam: '
    curl -sf {{ctrl}}{{v}}/status | jq -r '.streams[] | select(.name=="browser-cam") | .status'

# Detach the media endpoints, delete both browser streams, and stop the page.
browser-down:
    -@just consumer-down
    -@just producer-down
    -@just stream-rm browser-cam
    -@just stream-rm browser-return
    -@{{compose}} --profile browser rm -sf browser

# Strom for open-live to drive, on net_core behind profile `open-live`. Waits for its API.
[doc("Start the Strom open-live drives (profile `open-live`, host port 28083).")]
open-live-strom-up:
    {{compose}} --profile open-live up -d open-live-strom
    @for _ in $(seq 1 30); do \
        curl -sf {{strom_ol}}/api/version >/dev/null 2>&1 && \
        { echo "open-live strom ready at {{strom_ol}}"; exit 0; }; \
        sleep 2; \
    done; echo "timeout waiting for open-live strom" >&2; exit 1

open-live-strom-down:
    {{compose}} --profile open-live rm -sf open-live-strom

# Serve the page for a browser on this host. It needs a localhost origin for the
# camera, and southbound's CORS default of `*` lets it register from there.
[doc("Serve nodes/browser on localhost:<port> for a browser on this host; prints the URL to open.")]
page port="8000":
    @echo "open  http://localhost:{{port}}/#southbound={{sb}}&token={{sb_token}}"
    python3 -m http.server {{port}} -d {{page_dir}} --bind 127.0.0.1

# The stream a page on this host feeds: WHIP signalled at localhost:28080 via node
# 1's `docker-host` alias, SRT out on the node subnet for open-live's Strom.
[doc("Apply browser-cam-host for <node-id> (a page on this host); print its WHIP URL and SRT output.")]
host-cam id:
    #!/usr/bin/env bash
    set -euo pipefail
    tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
    sed "s/BROWSER_NODE/{{id}}/" {{manifests}}/browser-cam-host.yaml > "$tmp"
    WEAVE_NORTHBOUND_URL={{nb}} WEAVE_NORTHBOUND_TOKEN={{nb_token}} \
        cargo run --quiet -p weave-cli -- apply -f "$tmp"
    url=""
    for _ in $(seq 1 15); do
        url="$(curl -sf {{sb_auth}} {{sb}}{{v}}/nodes/{{id}}/desired \
            | jq -r '.[] | select(.id=="weave-browser-cam-host-sender") | .egresses[0].url' 2>/dev/null || true)"
        [ -n "$url" ] && break
        sleep 2
    done
    if [ -z "$url" ]; then
        echo "browser-cam-host has no hop on {{id}} yet — is that page registered? 'just bench status' lists nodes" >&2
        exit 1
    fi
    out="$(WEAVE_NORTHBOUND_TOKEN={{nb_token}} bash {{scripts}}/endpoints.sh browser-cam-host output 0)"
    echo "page sends WHIP to:     $url"
    echo "open-live dials:        srt://$out?mode=caller  (listed by its weave provider)"

host-cam-down:
    @just stream-rm browser-cam-host

# Impair a node's network via its router, e.g. `just netem node1 delay 200ms loss 5%`.
netem +ARGS:
    bash {{scripts}}/netem.sh {{ARGS}}

# Clear impairment on a node, e.g. `just netem-clear node1`.
netem-clear node:
    bash {{scripts}}/netem.sh {{node}} clear

# Show current qdiscs on a node's router, e.g. `just netem-show node1`.
netem-show node:
    bash {{scripts}}/netem.sh {{node}} show
