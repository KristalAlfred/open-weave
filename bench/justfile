compose   := "docker compose -f " + source_directory() / "docker-compose.yml"
scripts   := source_directory() / "scripts"
manifests := source_directory() / "manifests"
nb      := "https://localhost:29443"
sb      := "https://localhost:29444"
sb_plain := "http://localhost:29081"
ctrl    := "http://localhost:29082"
ctrl2   := "http://localhost:29083"
strom1  := "http://localhost:28080"
strom2  := "http://localhost:28081"
strom3  := "http://localhost:28082"
strom4  := "http://localhost:28083"
page_dir := source_directory() / ".." / "nodes" / "browser"

# northbound and southbound are reached through the `tls` proxy. The CLI trusts
# the bench CA through SSL_CERT_FILE, curl through --cacert.
ca  := source_directory() / "tls" / "public" / "ca.pem"
tls := "--cacert " + ca
cli := "SSL_CERT_FILE=" + ca + " WEAVE_NORTHBOUND_URL=" + nb + " cargo run --quiet -p weave-cli --"

# Northbound's bearer token, and the key southbound derives node tokens from.
# Defaults match docker-compose.yml so the bench needs no exports. `/health` and
# the controller dashboard need no token.
nb_token := env("WEAVE_NORTHBOUND_TOKEN", "bench-northbound-token")
nb_auth  := "-H 'Authorization: Bearer " + nb_token + "'"
sb_key   := env("WEAVE_SOUTHBOUND_KEY", "bench-southbound-key-for-local-use-only")

# Southbound's inventory reads accept any node's token; these recipes present
# node 1's, the one docker-compose.yml gives adapter-1 under the default key.
sb_token := env("WEAVE_ADAPTER_1_TOKEN", "strom-node-1.0.dc18eb10e0f080536c55f9ff6569abb31d2da3ce4f782b294dd0d32fcbd8dbaf")
sb_auth  := "-H 'Authorization: Bearer " + sb_token + "'"

# The in-bench page takes its node id from its token, so the browser manifests
# keep naming it across restarts.
browser_token := env("WEAVE_BROWSER_TOKEN", "browser-bench.0.ed7971623b06be894b581ccca99662bdb3983d232e8737a2c3e5a46455b00540")
browser_node  := replace_regex(browser_token, '\..*', '')
browser_2_token := env("WEAVE_BROWSER_2_TOKEN", "browser-bench-2.0.01b7733061b2fec1c70751c03fd9c027e962589084f12bbb6cee4c9a9e65ea82")
browser_2_node  := replace_regex(browser_2_token, '\..*', '')

# Port `just hook-sink` listens on. docker-compose.yml points the controller's
# WEAVE_WEBHOOK_URL at this port on host.docker.internal.
hook_port := env("WEAVE_WEBHOOK_PORT", "29099")
hook_token := env("WEAVE_WEBHOOK_TOKEN", "bench-webhook-token")

default:
    @just --list

# Build images and bring the whole stack up, then wait for it to be healthy.
[group("stack")]
up:
    {{compose}} build
    {{compose}} up -d
    @just wait

# Poll every service's health endpoint until the stack is ready.
[group("stack")]
wait:
    @echo "waiting for stack..."
    @for i in $(seq 1 90); do \
        curl -sf {{tls}} {{nb}}/health >/dev/null 2>&1 && \
        curl -sf {{tls}} {{sb}}/health >/dev/null 2>&1 && \
        curl -sf {{ctrl}}/health >/dev/null 2>&1 && \
        curl -sf {{ctrl2}}/health >/dev/null 2>&1 && \
        curl -sf {{strom1}}/api/version >/dev/null 2>&1 && \
        curl -sf {{strom2}}/api/version >/dev/null 2>&1 && \
        curl -sf {{strom3}}/api/version >/dev/null 2>&1 && \
        curl -sf {{strom4}}/api/version >/dev/null 2>&1 && \
        { echo "stack ready"; exit 0; }; \
        sleep 2; \
    done; echo "timeout waiting for stack" >&2; {{compose}} ps; exit 1

# Tear everything down: containers, networks, volumes (incl. profiled endpoints).
[group("stack")]
down:
    {{compose}} --profile producer --profile consumer --profile browser down -v --remove-orphans

# Remount node 2's adapter config and restart it: `rist` for a site reachable
# only over RIST (config/adapter-2-rist.yaml), `default` for adapter-2.yaml.
[group("stack")]
topology name="default":
    #!/usr/bin/env bash
    set -euo pipefail
    case "{{name}}" in
        default) config=adapter-2.yaml ;;
        rist) config=adapter-2-rist.yaml ;;
        *) echo "unknown topology {{name}}: use default or rist" >&2; exit 1 ;;
    esac
    WEAVE_ADAPTER_2_CONFIG="$config" {{compose}} up -d adapter-2
    echo "adapter-2 runs with config/$config"

# Container states for every bench service.
[group("stack")]
ps:
    {{compose}} ps

# Follow logs for a service (e.g. `just bench logs controller`).
[group("stack")]
logs svc="controller":
    {{compose}} logs -f --tail=40 {{svc}}

# Health of every service + nodes registered with southbound + controller view.
[group("stack")]
status:
    @echo "== health =="
    @printf "northbound:  "; curl -sf {{tls}} {{nb}}/health >/dev/null && echo ok || echo DOWN
    @printf "southbound:  "; curl -sf {{tls}} {{sb}}/health >/dev/null && echo ok || echo DOWN
    @printf "controller:  "; curl -sf {{ctrl}}/health >/dev/null && echo ok || echo DOWN
    @printf "controller-2:"; curl -sf {{ctrl2}}/health >/dev/null && echo " ok" || echo " DOWN"
    @printf "leading:     "; just leader 2>&1 || true
    @printf "strom-1:     "; curl -sf {{strom1}}/api/version >/dev/null && echo ok || echo DOWN
    @printf "strom-2:     "; curl -sf {{strom2}}/api/version >/dev/null && echo ok || echo DOWN
    @printf "strom-3:     "; curl -sf {{strom3}}/api/version >/dev/null && echo ok || echo DOWN
    @printf "strom-4:     "; curl -sf {{strom4}}/api/version >/dev/null && echo ok || echo DOWN
    @echo "== registered nodes (southbound) =="
    @curl -sf {{tls}} {{sb_auth}} {{sb}}/nodes | (jq . 2>/dev/null || cat)
    @echo "== /status (northbound, from the leading controller) =="
    @curl -sf {{tls}} {{nb_auth}} {{nb}}/status | (jq . 2>/dev/null || cat)
    @echo "== streams (northbound) =="
    @curl -sf {{tls}} {{nb_auth}} {{nb}}/streams | (jq . 2>/dev/null || cat)

# Presents node 1's token for node 2, to southbound and to the leading
# controller directly (it checks again), then two values that are not node
# tokens: the shared token southbound took before, and the key.
[doc("Check that a node token acts only for its own node.")]
[group("stack")]
auth-check:
    #!/usr/bin/env bash
    set -uo pipefail
    me="Authorization: Bearer {{sb_token}}"
    json="Content-Type: application/json"
    heartbeat='{"node_id":"strom-node-2","status":"ready","endpoints":[],"hop_status":[]}'
    leader="$(just leader)" || exit 1
    read -r _ ctrl <<<"$leader"
    failed=0
    expect() {
        local want="$1" what="$2"; shift 2
        local got; got="$(curl -s {{tls}} -o /dev/null -w '%{http_code}' "$@")"
        printf '%-46s %s\n' "$what" "$got"
        [ "$got" = "$want" ] || { echo "  expected $want" >&2; failed=1; }
    }
    expect 200 "southbound: desired hops as strom-node-1" -H "$me" {{sb}}/nodes/strom-node-1/desired
    expect 403 "southbound: desired hops as strom-node-2" -H "$me" {{sb}}/nodes/strom-node-2/desired
    expect 403 "southbound: heartbeat as strom-node-2" -H "$me" -H "$json" -d "$heartbeat" {{sb}}/nodes/strom-node-2/heartbeat
    expect 403 "southbound: register as strom-node-2" -H "$me" -H "$json" -d '{"node":{"id":"strom-node-2"}}' {{sb}}/nodes/register
    expect 403 "controller: desired hops as strom-node-2" -H "$me" "$ctrl/nodes/strom-node-2/desired"
    expect 403 "controller: heartbeat as strom-node-2" -H "$me" -H "$json" -d "$heartbeat" "$ctrl/nodes/strom-node-2/heartbeat"
    expect 401 "southbound: old shared token" -H "Authorization: Bearer bench-southbound-token" {{sb}}/nodes
    expect 401 "southbound: the key as a token" -H "Authorization: Bearer {{sb_key}}" {{sb}}/nodes
    exit "$failed"

[doc("Check that the TLS endpoints verify against the bench CA, and fail without it.")]
[group("stack")]
tls-check:
    #!/usr/bin/env bash
    set -uo pipefail
    failed=0
    check() {
        local what="$1"; shift
        if "$@" >/dev/null 2>&1; then r=yes; else r=NO; failed=1; fi
        printf '%-56s %s\n' "$what" "$r"
    }
    check "curl verifies northbound against the bench CA" curl -sf {{tls}} {{nb}}/health
    check "curl verifies southbound against the bench CA" curl -sf {{tls}} {{sb}}/health
    check "curl without the bench CA refuses southbound" sh -c 'curl -s {{sb}}/health; [ $? -eq 60 ]'
    check "weave trusts the bench CA from SSL_CERT_FILE" env WEAVE_NORTHBOUND_TOKEN={{nb_token}} {{cli}} get status
    check "weave without SSL_CERT_FILE refuses the certificate" sh -c 'env -u SSL_CERT_FILE WEAVE_NORTHBOUND_TOKEN={{nb_token}} cargo run --quiet -p weave-cli -- --url {{nb}} get status 2>&1 | grep -q UnknownIssuer'
    exit "$failed"

# List the available stream manifests with their one-line description.
[group("streams")]
stream-ls:
    @for f in {{manifests}}/*.yaml; do \
        printf "%-16s %s\n" "$(basename "$f" .yaml)" "$(head -1 "$f" | sed 's/^# *//')"; \
    done

# Apply a manifest by name (stem == stream name), e.g. `just bench stream basic`.
# Control plane only: the stream is registered and placed, but nothing feeds it,
# so it settles at `awaiting_input`. Use `just bench stream-up` to also drive media.
[doc("Apply a manifest by name, control plane only (no media).")]
[group("streams")]
stream name:
    @WEAVE_NORTHBOUND_TOKEN={{nb_token}} {{cli}} apply -f {{manifests}}/{{name}}.yaml
    @[ -n "${WEAVE_BENCH_DRIVING:-}" ] || \
        echo "applied {{name}} (no media yet — 'just bench stream-up {{name}}' drives it end to end)"

# Attach the external producer to the stream's ingress and one consumer per
# receiver output, then wait for `flowing`. This is the recipe to reach for;
# `just bench stream` alone leaves the path unfed.
#
# The producer/consumer containers are singletons, so this re-points them at
# <name>: a previously driven stream loses its media and falls back to `degraded`.
[doc("Apply a manifest AND drive it end to end, waiting for `flowing`.")]
[group("streams")]
stream-up name="basic":
    #!/usr/bin/env bash
    set -euo pipefail
    WEAVE_BENCH_DRIVING=1 just stream {{name}}
    # Not every manifest is drivable. Wait for placement to resolve, then say why
    # rather than letting endpoint discovery poll a stream that will never place.
    for _ in $(seq 1 10); do
        placed="$(curl -sf {{tls}} {{nb_auth}} {{nb}}/status \
            | jq -r --arg n {{name}} '.streams[] | select(.name==$n) | .status' 2>/dev/null || true)"
        [ -n "$placed" ] && [ "$placed" != "pending" ] && break
        sleep 2
    done
    case "${placed:-}" in
        idle)
            echo "{{name}} is disabled (enabled: false) — no hops provisioned, nothing to drive"
            exit 0 ;;
        pending|"")
            echo "{{name}} never placed (status ${placed:-unknown}) — no node matched its hops," \
                 "so there is no ingress to feed. 'just bench status' shows registered nodes." >&2
            exit 1 ;;
    esac
    outputs="$(WEAVE_NORTHBOUND_TOKEN={{nb_token}} bash {{scripts}}/endpoints.sh {{name}} destinations)"
    ids="$(WEAVE_NORTHBOUND_TOKEN={{nb_token}} bash {{scripts}}/endpoints.sh {{name}} destination-ids)"
    first="$(printf '%s\n' "$ids" | awk '{print $1}')"
    second="$(printf '%s\n' "$ids" | awk '{print $2}')"
    echo "{{name}} placed with $outputs receiver output(s); attaching endpoints"
    # The endpoints dial with the passphrases the manifest gives their sockets.
    spec="$(curl -sf {{tls}} {{nb_auth}} {{nb}}/streams/{{name}})"
    passphrase() { printf '%s' "$spec" | jq -r "$1 // empty"; }
    destination_passphrase() {
        passphrase ".spec.destinations[] | select(.id==\"$1\") | .srt.passphrase"
    }
    just producer-up {{name}} "$(passphrase .spec.source.srt.passphrase)"
    just consumer-up {{name}} "$first" "$(destination_passphrase "$first")"
    # Only two consumer slots exist; say so rather than silently under-driving a
    # path, which would look like a stuck `degraded`.
    if [ "$outputs" -ge 2 ]; then
        just consumer-2-up {{name}} "$second" "$(destination_passphrase "$second")"
    fi
    if [ "$outputs" -gt 2 ]; then
        echo "warning: {{name}} has $outputs outputs but the bench has 2 consumers;" \
             "outputs 2+ stay unattached and the stream will report degraded" >&2
    fi
    just stream-wait {{name}} flowing

# Stop driving a stream and remove it: detach the external endpoints, then delete.
[group("streams")]
stream-down name="basic":
    -@just producer-down
    -@just consumer-down
    -@just consumer-2-down
    @just stream-rm {{name}}

# Poll /status until a stream reports `status`, e.g. `just bench stream-wait basic flowing`.
[group("streams")]
stream-wait name status="flowing" attempts="45":
    #!/usr/bin/env bash
    set -euo pipefail
    for _ in $(seq 1 {{attempts}}); do
        got="$(curl -sf {{tls}} {{nb_auth}} {{nb}}/status \
            | jq -r --arg n {{name}} '.streams[] | select(.name==$n) | .status' 2>/dev/null || true)"
        if [ "$got" = "{{status}}" ]; then echo "{{name}}: {{status}}"; exit 0; fi
        sleep 2
    done
    echo "{{name}}: timed out waiting for {{status}} (last: ${got:-unknown})" >&2
    echo "inspect with 'just bench status' or the leading controller's dashboard at {{ctrl}}/ui or {{ctrl2}}/ui" >&2
    exit 1

# Remove a stream by name, e.g. `just bench stream-rm basic`. Controller tears down its hops next tick.
[group("streams")]
stream-rm name:
    #!/usr/bin/env bash
    set -euo pipefail
    headers="$(mktemp)"; body="$(mktemp)"; trap 'rm -f "$headers" "$body"' EXIT
    # DELETE needs the stream's current ETag as If-Match.
    status="$(curl -s -o "$body" -D "$headers" -w '%{http_code}' {{tls}} {{nb_auth}} {{nb}}/streams/{{name}} || true)"
    case "$status" in
        200) ;;
        404) echo "not found: {{name}}"; exit 0 ;;
        *) echo "cannot read {{name}}: northbound returned $status $(cat "$body")" >&2; exit 1 ;;
    esac
    etag="$(awk 'tolower($1) == "etag:" { print $2 }' "$headers" | tr -d '\r')"
    status="$(curl -s -o "$body" -w '%{http_code}' {{tls}} {{nb_auth}} -H "If-Match: $etag" \
        -X DELETE {{nb}}/streams/{{name}} || true)"
    case "$status" in
        204) echo "deleted {{name}}" ;;
        404) echo "not found: {{name}}" ;;
        *) echo "cannot delete {{name}}: northbound returned $status $(cat "$body")" >&2; exit 1 ;;
    esac

# Print the compose service and URL of the controller that holds the lease.
[group("stack")]
leader:
    #!/usr/bin/env bash
    set -uo pipefail
    for pair in "controller {{ctrl}}" "controller-2 {{ctrl2}}"; do
        read -r svc url <<<"$pair"
        if [ "$(curl -s -o /dev/null -w '%{http_code}' "$url/status")" = 200 ]; then
            echo "$svc $url"
            exit 0
        fi
    done
    echo "no controller leads; 'just bench ps' shows which are up" >&2
    exit 1

# Restart, kill or stop the leading controller while <stream> flows, and wait
# for a controller to lead again. Fails if any `weave-` flow on the four Stroms
# was deleted, recreated or stopped moving bytes, if an adapter logged a delete,
# if a producer or consumer restarted ffmpeg, if a Strom node reads `offline`, if
# the stream's generation or ETag changed, if re-applying its manifest fails, or
# if the stream does not read `flowing` again. `how=kill` sends SIGKILL instead
# of a clean stop. `how=stop` keeps the old leader down through the checks, then
# starts it again and fails unless it stands by.
[doc("Restart, kill or stop the leading controller with <stream> flowing and check that no Strom flow dropped.")]
[group("streams")]
controller-restart stream="basic" how="restart":
    #!/usr/bin/env bash
    set -euo pipefail
    case "{{how}}" in
        restart|kill|stop) ;;
        *) echo "how must be restart, kill or stop, not {{how}}" >&2; exit 2 ;;
    esac
    just stream-wait {{stream}} flowing 5 >/dev/null || {
        echo "{{stream}} is not flowing; 'just bench stream-up {{stream}}' drives it" >&2
        exit 1
    }
    snapshot() {
        for strom in {{strom1}} {{strom2}} {{strom3}} {{strom4}}; do
            curl -sf "$strom/api/flows" \
                | jq -r '.flows[] | select(.name | startswith("weave-")) | "\(.name) \(.id)"' \
                | while read -r name id; do
                    moved="$(curl -sf "$strom/api/flows/$id/srt-stats" \
                        | jq '[.. | objects | (.bytes_received // 0) + (.bytes_sent // 0)] | add // 0')"
                    echo "$name $id $moved"
                done
        done | sort
    }
    identity() {
        etag="$(curl -sf {{tls}} -D - -o /dev/null {{nb_auth}} {{nb}}/streams/{{stream}} \
            | tr -d '\r' | awk 'tolower($1) == "etag:" { print $2 }')"
        generation="$(curl -sf {{tls}} {{nb_auth}} {{nb}}/streams/{{stream}} | jq .generation)"
        echo "etag $etag generation $generation"
    }
    leader="$(just leader)"
    read -r old old_url <<<"$leader"
    echo "leading: $old"
    before="$(snapshot)"
    identity_before="$(identity)"
    echo "== weave- flows before (name id bytes) =="
    echo "$before"
    echo "{{stream}}: $identity_before"
    since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    case "{{how}}" in
        restart) {{compose}} restart "$old" ;;
        kill) docker kill -s KILL "ow-$old" >/dev/null && {{compose}} start "$old" ;;
        stop) {{compose}} stop "$old" ;;
    esac
    new=""
    for _ in $(seq 1 30); do
        if leader="$(just leader 2>/dev/null)"; then
            read -r new _ <<<"$leader"
            break
        fi
        sleep 1
    done
    [ -n "$new" ] || { echo "FAIL: no controller leads after {{how}}" >&2; exit 1; }
    echo "leading after {{how}}: $new; waiting 20s for every adapter to poll it"
    sleep 20
    after="$(snapshot)"
    echo "== weave- flows after =="
    echo "$after"
    failed=0
    if [ "{{how}}" = stop ] && [ "$new" = "$old" ]; then
        echo "FAIL: $old leads again while it should be down" >&2
        failed=1
    fi
    if [ "$(cut -d' ' -f1,2 <<<"$before")" != "$(cut -d' ' -f1,2 <<<"$after")" ]; then
        echo "FAIL: the set of weave- flows or their ids changed" >&2
        failed=1
    fi
    while read -r name id moved; do
        now="$(awk -v id="$id" '$2 == id { print $3 }' <<<"$after")"
        if [ -n "$now" ] && [ "$now" -le "$moved" ]; then
            echo "FAIL: $name moved no bytes across the switch ($moved -> $now)" >&2
            failed=1
        fi
    done <<<"$before"
    for adapter in ow-adapter-1 ow-adapter-2 ow-adapter-3 ow-adapter-4; do
        if docker logs --since "$since" "$adapter" 2>&1 | grep "deleted undesired managed flow"; then
            echo "FAIL: $adapter deleted a flow" >&2
            failed=1
        fi
    done
    for endpoint in ow-producer ow-producer-3 ow-producer-4 ow-consumer ow-consumer-2 ow-consumer-3 ow-consumer-4; do
        if docker logs --since "$since" "$endpoint" 2>/dev/null | grep "ffmpeg exited"; then
            echo "FAIL: $endpoint restarted ffmpeg" >&2
            failed=1
        fi
    done
    offline="$(curl -sf {{tls}} {{nb_auth}} {{nb}}/nodes \
        | jq -r '.[] | select((.id | startswith("strom-node-")) and .status == "offline") | .id')"
    if [ -n "$offline" ]; then
        echo "FAIL: offline after the switch: $offline" >&2
        failed=1
    fi
    identity_after="$(identity)"
    if [ "$identity_after" != "$identity_before" ]; then
        echo "FAIL: {{stream}} changed from '$identity_before' to '$identity_after'" >&2
        failed=1
    fi
    WEAVE_BENCH_DRIVING=1 just stream {{stream}} || { echo "FAIL: re-applying {{stream}} failed" >&2; failed=1; }
    just stream-wait {{stream}} flowing
    if [ "{{how}}" = stop ]; then
        {{compose}} start "$old"
        for _ in $(seq 1 30); do
            curl -sf "$old_url/health" >/dev/null 2>&1 && break
            sleep 1
        done
        sleep 3
        code="$(curl -s "$old_url/status" | jq -r .code)"
        leader="$(just leader)" || true
        read -r leading _ <<<"$leader"
        echo "$old is back: /status says ${code}; $leading leads"
        if [ "$code" != not_leader ] || [ "$leading" != "$new" ]; then
            echo "FAIL: $old did not come back as a standby" >&2
            failed=1
        fi
    fi
    [ "$failed" = 0 ] && echo "ok: every weave- flow kept its id and kept moving bytes"
    exit "$failed"

# Pass a stream name; the ingress address is resolved via the controller's
# discovery API. A passphrase, when given, goes into the producer's SRT URL.
# Verification endpoint only — not part of the system under test.
#
# A socket on node 3 or 4 can only be dialled from inside that node's subnet, so
# the endpoint is picked from the address: 10.97.29.x means the `-3` container,
# 10.97.30.x the `-4` one, anything else the net_core one. The recipe obeys the
# same reachability the planner does.
[doc("Start the external ffmpeg producer (SRT caller into a source ingress).")]
[group("media")]
producer-up stream="basic" passphrase="":
    #!/usr/bin/env bash
    set -euo pipefail
    target="$(WEAVE_NORTHBOUND_TOKEN={{nb_token}} bash {{scripts}}/endpoints.sh {{stream}} ingress)"
    svc="producer$(bash {{scripts}}/inside.sh "$target")"
    echo "producer: dialling $target from $svc"
    PRODUCER_TARGET="$target" PRODUCER_PASSPHRASE="{{passphrase}}" \
        {{compose}} --profile producer up -d "$svc"

# Stop and remove the external producer, whichever subnet it was started in.
[group("media")]
producer-down:
    -@{{compose}} --profile producer rm -sf producer producer-3 producer-4

# Pass a stream name; the first output address is resolved via discovery. A
# passphrase, when given, goes into the consumer's SRT URL.
[doc("Start the external ffmpeg consumer (SRT caller pulling a receiver output).")]
[group("media")]
consumer-up stream="basic" destination="output" passphrase="":
    #!/usr/bin/env bash
    set -euo pipefail
    source="$(WEAVE_NORTHBOUND_TOKEN={{nb_token}} bash {{scripts}}/endpoints.sh {{stream}} destination {{destination}})"
    svc="consumer$(bash {{scripts}}/inside.sh "$source")"
    echo "consumer: dialling $source from $svc"
    CONSUMER_SOURCE="$source" CONSUMER_PASSPHRASE="{{passphrase}}" \
        {{compose}} --profile consumer up -d "$svc"

# Stop and remove the external consumer, whichever subnet it was started in.
[group("media")]
consumer-down:
    -@{{compose}} --profile consumer rm -sf consumer consumer-3 consumer-4

# For fan-out: one consumer per receiver output, so every receiver hop can flow.
# Pass a stream name; the second output address is resolved via discovery.
[doc("Start a second external consumer, attached to a stream's output 1.")]
[group("media")]
consumer-2-up stream="fanout" destination="studio" passphrase="":
    #!/usr/bin/env bash
    set -euo pipefail
    source="$(WEAVE_NORTHBOUND_TOKEN={{nb_token}} bash {{scripts}}/endpoints.sh {{stream}} destination {{destination}})"
    CONSUMER_SOURCE_2="$source" CONSUMER_PASSPHRASE_2="{{passphrase}}" \
        {{compose}} --profile consumer up -d consumer-2

# Stop and remove the second external consumer.
[group("media")]
consumer-2-down:
    {{compose}} --profile consumer rm -sf consumer-2

# Build and start the headless browser node inside the bench, then print its id.
# `just bench browser-up video` sends the camera alone, with no microphone.
[doc("Start the in-bench browser node (profile `browser`) and print its node id.")]
[group("browser")]
browser-up media="":
    WEAVE_BROWSER_MEDIA={{media}} {{compose}} --profile browser up -d --build browser
    @just browser-id

# Wait for a browser node (default: the in-bench page) to register, then echo it.
[group("browser")]
browser-id node=browser_node svc="browser":
    #!/usr/bin/env bash
    set -euo pipefail
    for _ in $(seq 1 30); do
        got="$(curl -sf {{tls}} {{sb_auth}} {{sb}}/nodes \
            | jq -r --arg id '{{node}}' '.[] | select(.id==$id) | .id' 2>/dev/null || true)"
        if [ -n "$got" ]; then echo "$got"; exit 0; fi
        sleep 2
    done
    echo "{{node}} has not registered with southbound;" \
         "'just bench logs {{svc}}' shows why, 'just bench status' lists the nodes there are" >&2
    exit 1

# Start the second in-bench page, node `browser-bench-2`, then print its id.
[group("browser")]
browser-2-up:
    {{compose}} --profile browser up -d browser-2
    @just browser-id {{browser_2_node}} browser-2

# Apply browser-b2b: the first page's camera to the second page's screen, relayed
# through node 1's `whip-to-whep`. Needs both pages up.
[doc("Apply browser-b2b between the two in-bench pages and wait for `flowing`.")]
[group("browser")]
browser-b2b:
    #!/usr/bin/env bash
    set -euo pipefail
    tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
    sed -e "s/browser-placeholder/$(just browser-id)/" \
        -e "s/viewer-placeholder/$(just browser-id {{browser_2_node}} browser-2)/" \
        {{manifests}}/browser-b2b.yaml > "$tmp"
    WEAVE_NORTHBOUND_TOKEN={{nb_token}} {{cli}} apply -f "$tmp"
    just stream-wait browser-b2b flowing

# Apply browser-cam and browser-return for the page and drive both: the camera
# stream's SRT output is pulled by the consumer, the return stream's SRT ingress
# is fed by the producer and played on the page.
[doc("Apply both browser manifests for <node-id> (default: the pinned page) and drive them end to end.")]
[group("browser")]
browser-stream id="":
    #!/usr/bin/env bash
    set -euo pipefail
    id="{{id}}"
    [ -n "$id" ] || id="$(just browser-id)"
    tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
    for m in browser-cam browser-return; do
        sed "s/browser-placeholder/$id/" {{manifests}}/$m.yaml > "$tmp"
        WEAVE_NORTHBOUND_TOKEN={{nb_token}} {{cli}} apply -f "$tmp"
    done
    just consumer-up browser-cam
    just producer-up browser-return
    just stream-wait browser-return flowing
    just stream-wait browser-cam flowing

# Detach the media endpoints, delete the browser streams, and stop the pages.
[group("browser")]
browser-down:
    -@just consumer-down
    -@just producer-down
    -@just stream-rm browser-cam
    -@just stream-rm browser-return
    -@just stream-rm browser-b2b
    -@{{compose}} --profile browser rm -sf browser browser-2

# Serve the page for a browser on this host. It needs a localhost origin for the
# camera, and southbound's CORS default of `*` lets it register from there. It
# calls southbound's plaintext port: a browser on the host does not trust the
# bench CA.
# `seat` is the page's node id: the URL carries that seat's token and pins the
# id with `#node=`. A guest who rejoins with the same seat keeps the id, so the
# applied stream keeps pointing at a live node — and open-live, which keys its
# source doc on the stream, keeps the mixer input the operator had assigned.
# Concurrent guests need distinct seats.
[doc("Serve nodes/browser on localhost:<port> pinned to <seat>, for a browser on this host; prints the URL to open.")]
[group("browser")]
page port="8000" seat="guest-1":
    @echo "open  http://localhost:{{port}}/#southbound={{sb_plain}}&token=$(just node-token {{seat}})&node={{seat}}&network=docker-host"
    python3 -m http.server {{port}} -d {{page_dir}} --bind 127.0.0.1

# Print the southbound token for node <id> at <epoch> under the bench key.
[group("browser")]
node-token id epoch="0":
    @WEAVE_SOUTHBOUND_KEY={{sb_key}} cargo run --quiet -p weave-cli -- node-token {{id}} --epoch {{epoch}}

# The stream a page on this host feeds: WHIP signalled at localhost:28080 via node
# 1's `docker-host` attachment, SRT out on the node subnet for open-live's Strom.
[doc("Apply browser-cam-host for <seat> (the id `just bench page` pinned); print its WHIP URL and SRT output.")]
[group("browser")]
host-cam seat="guest-1":
    #!/usr/bin/env bash
    set -euo pipefail
    tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
    sed "s/browser-placeholder/{{seat}}/" {{manifests}}/browser-cam-host.yaml > "$tmp"
    WEAVE_NORTHBOUND_TOKEN={{nb_token}} {{cli}} apply -f "$tmp"
    seat_auth="Authorization: Bearer $(just node-token {{seat}})"
    url=""
    for _ in $(seq 1 15); do
        url="$(curl -sf {{tls}} -H "$seat_auth" {{sb}}/nodes/{{seat}}/desired \
            | jq -r '.[] | select(.id=="weave-browser-cam-host-sender") | .egresses[0].url' 2>/dev/null || true)"
        [ -n "$url" ] && break
        sleep 2
    done
    if [ -z "$url" ]; then
        echo "browser-cam-host has no hop on {{seat}} yet — is that page registered? 'just bench status' lists nodes" >&2
        exit 1
    fi
    out="$(WEAVE_NORTHBOUND_TOKEN={{nb_token}} bash {{scripts}}/endpoints.sh browser-cam-host destination output)"
    echo "page sends WHIP to:     $url"
    echo "open-live dials:        srt://$out?mode=caller  (listed by its weave provider)"

# Delete the browser-cam-host stream.
[group("browser")]
host-cam-down:
    @just stream-rm browser-cam-host

# The controller only delivers when WEAVE_WEBHOOK_URL is set on its service, so
# start this before `just bench up` and expect a connection-refused line in the
# controller log for anything emitted while it is down.
[doc("Print the webhooks the controller delivers, until interrupted.")]
[group("webhooks")]
hook-sink:
    #!/usr/bin/env python3
    import http.server, json, sys

    class Sink(http.server.BaseHTTPRequestHandler):
        def do_POST(self):
            body = self.rfile.read(int(self.headers.get("content-length", 0)))
            auth = self.headers.get("authorization", "<none>")
            try:
                event = json.loads(body)
                subject = event["node"]["id"] if "node" in event else event["stream"]["name"]
                line = f"{event['event_type']:16} {subject:16} {event['occurred_at']}"
                detail = json.dumps(event, indent=2)
            except (ValueError, KeyError):
                line, detail = "<unparsed>", body.decode("utf-8", "replace")
            print(f"{line}\n  authorization: {auth}\n{detail}", flush=True)
            self.send_response(200)
            self.end_headers()

        def log_message(self, *_):
            pass

    print("webhook sink on http://0.0.0.0:{{hook_port}} — ctrl-c to stop", flush=True)
    try:
        http.server.HTTPServer(("0.0.0.0", {{hook_port}}), Sink).serve_forever()
    except KeyboardInterrupt:
        sys.exit(0)

# Impair a node's network via its router, e.g. `just bench netem node1 delay 200ms loss 5%`.
[group("impairment")]
netem +ARGS:
    bash {{scripts}}/netem.sh {{ARGS}}

# Clear impairment on a node, e.g. `just bench netem-clear node1`.
[group("impairment")]
netem-clear node:
    bash {{scripts}}/netem.sh {{node}} clear

# Show current qdiscs on a node's router, e.g. `just bench netem-show node1`.
[group("impairment")]
netem-show node:
    bash {{scripts}}/netem.sh {{node}} show
