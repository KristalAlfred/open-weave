compose := "docker compose -f " + source_directory() / "docker-compose.yml"
scripts := source_directory() / "scripts"
ingress := "http://localhost:18080"
egress  := "http://localhost:18081"

default:
    @just --list

# Bring the bench up and wait for both strom nodes to answer.
up:
    {{compose}} up -d
    @echo "waiting for strom nodes..."
    @for i in $(seq 1 60); do \
        curl -sf {{ingress}}/api/version >/dev/null 2>&1 && \
        curl -sf {{egress}}/api/version >/dev/null 2>&1 && \
        { echo "strom ingress+egress ready"; exit 0; }; \
        sleep 1; \
    done; echo "timeout waiting for strom" >&2; exit 1

# Tear everything down: containers, networks, volumes.
down:
    {{compose}} down -v --remove-orphans
    -rm -f {{source_directory()}}/.flow-ids.env

# Create + start the ingress and egress flows, persist their IDs.
flows:
    bash {{scripts}}/flows.sh

# Create + start ONLY egress; leave the ingress side for the weave controller.
flows-egress:
    bash {{scripts}}/flows-egress.sh

# Poll srt-stats from both nodes and pretty-print key fields.
stats:
    bash {{scripts}}/stats.sh

# Follow logs for a service (e.g. `just logs consumer`).
logs svc="consumer":
    {{compose}} logs -f --tail=40 {{svc}}

ps:
    {{compose}} ps

# --- impairment (applied on the router between the two nodes) ---

degrade-loss pct:
    bash {{scripts}}/netem.sh loss {{pct}}

degrade-latency ms jitter="0ms":
    bash {{scripts}}/netem.sh delay {{ms}} {{trim_end_match(jitter, "ms")}}

reorder:
    bash {{scripts}}/netem.sh reorder

blackout:
    bash {{scripts}}/netem.sh blackout

# Clear all impairment (heal the link).
heal:
    bash {{scripts}}/netem.sh clear

# Alias for heal.
clean:
    bash {{scripts}}/netem.sh clear

netem-show:
    bash {{scripts}}/netem.sh show
